FROM jenkins/jenkins:2.571-jdk21
USER root

# Optional: trust an extra CA for networks behind a TLS-inspecting proxy (e.g.
# Zscaler). Drop the proxy's root CA at certs/corp-ca.pem (gitignored) — see
# DEMO.md. jenkins-plugin-cli is a Java tool, so the CA must go into BOTH the OS
# trust store (curl/apt) AND the JVM truststore (keytool). No cert => no-op, so
# the image still builds unchanged on an open network.
COPY certs/ /tmp/extra-ca/
RUN set -eu; \
    if ls /tmp/extra-ca/*.pem >/dev/null 2>&1 || ls /tmp/extra-ca/*.crt >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends ca-certificates; \
      i=0; \
      for bundle in /tmp/extra-ca/*.pem /tmp/extra-ca/*.crt; do \
        [ -e "$bundle" ] || continue; \
        # split a bundle into one cert per file (keytool/update-ca-certs want singles)
        awk -v d=/usr/local/share/ca-certificates -v s="$i" \
          'BEGIN{n=s} /BEGIN CERTIFICATE/{n++} {print > (d"/extra-"n".crt")} END{print n > "/tmp/ca_n"}' "$bundle"; \
        i=$(cat /tmp/ca_n); \
      done; \
      for c in /usr/local/share/ca-certificates/extra-*.crt; do \
        keytool -importcert -noprompt -trustcacerts -alias "$(basename "$c" .crt)" \
          -file "$c" -keystore "$JAVA_HOME/lib/security/cacerts" -storepass changeit >/dev/null 2>&1 || true; \
      done; \
      update-ca-certificates; \
    fi; \
    rm -rf /tmp/extra-ca /tmp/ca_n

RUN apt-get update && apt-get install -y lsb-release ca-certificates curl && \
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc && \
    chmod a+r /etc/apt/keyrings/docker.asc && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
    https://download.docker.com/linux/debian $(. /etc/os-release && echo \"$VERSION_CODENAME\") stable" \
    | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && apt-get install -y docker-ce-cli && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Python toolchain for pipeline stages (flake8, pytest, anthropic, mcp). The
# base image ships only the JVM, so `pip` is absent and `agent any` builds fail
# with "pip: not found". Install Python into a venv on PATH so `pip`/`python3`
# resolve globally AND `pip install` works without hitting the base image's
# PEP 668 "externally-managed-environment" block. `chown` the venv to the
# `jenkins` user — the build runs as root but the pipeline runs as `jenkins`,
# which otherwise can't write to the root-owned venv (pip: "Permission denied").
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && \
    python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip && \
    # Bake the pipeline's Python deps into the image so builds don't `pip install`
    # them on every run (faster, reproducible, and avoids a runtime certifi
    # upgrade clobbering the CA we append below). certifi arrives transitively.
    /opt/venv/bin/pip install --no-cache-dir flake8 pytest anthropic mcp requests && \
    # Behind a TLS-inspecting proxy, Python (httpx via the anthropic SDK, and
    # requests in the MCP server) verifies against certifi's own bundle — NOT the
    # OS store. If the opt-in CA block above trusted a corp root, append it to
    # certifi so unmodified Python code trusts the proxy too. No cert => no-op.
    if ls /usr/local/share/ca-certificates/extra-*.crt >/dev/null 2>&1; then \
      cat /usr/local/share/ca-certificates/extra-*.crt >> "$(/opt/venv/bin/python -m certifi)"; \
    fi && \
    chown -R jenkins:jenkins /opt/venv && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
# Point CA-env-aware tools (requests honors REQUESTS_CA_BUNDLE) at the OS bundle,
# which the CA block keeps updated. httpx ignores these, which is why we also
# baked the corp CA into certifi above.
ENV PATH="/opt/venv/bin:$PATH" \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
USER jenkins
RUN jenkins-plugin-cli --plugins "blueocean docker-workflow json-path-api"
